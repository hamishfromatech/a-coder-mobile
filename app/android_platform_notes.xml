<!-- In android/app/src/main/res/xml/network_security_config.xml: -->
<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
  <!-- Allow cleartext (ws://) to LAN subnets -->
  <domain-config cleartextTrafficPermitted="true">
    <domains>
      <domain includeSubdomains="false">192.168.0.1</domain>
      <domain includeSubdomains="false">10.0.0.1</domain>
      <domain includeSubdomains="false">172.16.0.1</domain>
    </domains>
  </domain-config>
</network-security-config>

<!-- In android/app/src/main/AndroidManifest.xml, reference the security config: -->
<!-- android:networkSecurityConfig="@xml/network_security_config" in the <application> tag -->
