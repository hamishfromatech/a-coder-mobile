{
  "name": "@acoder/serve-bridge",
  "version": "0.1.0",
  "description": "A-Coder engine WebSocket bridge — spawns a-coder-cli --mode rpc and exposes it over authenticated WebSockets with mDNS discovery.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "acoder-serve": "./dist/serve/serve-command.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "qrcode": "^1.5.4",
    "bonjour-service": "^1.2.1",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
